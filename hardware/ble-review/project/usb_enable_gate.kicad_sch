  (text "1. MAIN RAIL MUST BE PRESENT BEFORE USB DATA CONNECTS"
    (at 25.4 20.32 0)
    (effects
      (font
        (size 1.8 1.8))
      (justify left))
    (uuid "f39fd8df-3421-41d8-873d-931f600b818d"))
  (text "U7302 is supplied by USB_3V3, so VLOGIC_SWITCHED = 0 V cannot float its reset output.\nR7310/R7311 set a nominal falling trip of 2.967 V. Both resistors: 0.1%, 25 ppm/C.\nCT deliberately open. RESET is wired-AND with VBUS monitor U7301 on USB_DATA_EN."
    (at 25.4 137.16 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left))
    (uuid "c6c933d8-f5e2-4fc8-93f2-ad8353d5d277"))
  (text "2. RAW VBUS DISCHARGE"
    (at 25.4 165.1 0)
    (effects
      (font
        (size 1.8 1.8))
      (justify left))
    (uuid "4cf5db53-98aa-44a7-ad1f-115143311c94"))
  (text "R7309 limits retained VBUS after cable removal. 1206 / 250 mW required.\nAt 20 V: nominal 148 mW. At 5.5 V: 11.2 mW. Do not substitute 0.1 W 0603.\nHost source collapse, switch bounce, main-rail dynamics and USB suspend remain sample tests."
    (at 119.38 190.5 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left))
    (uuid "0f11b1a7-6db7-426a-9240-94c5d49b342c"))
  (text "DESIGN LIMIT: comparator tolerances and delay do not prove USB compliance or transient safety.\nCapture DATA_EN, main rail, VBUS and D+/D- on both prototypes before release."
    (at 25.4 241.3 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left))
    (uuid "5c3d8a59-0916-48f9-898e-da321f3ed46b")))
