  (text "SW7201: OFF-BOARD enclosure SPDT switch, pin 2 common. Two insulated leads to J7201; OFF throw is NC.\nNORMAL: VBUS inhibits EN_RUN; SERVICE exception is on usb_service sheet.\nSwitch mounting, strain relief and power-off timing require physical validation."
    (at 25.4 20.32 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left))
    (uuid "d66a373a-2e72-40af-9eb3-890cf0750c28"))
  (no_connect
    (at 228.6 90.17)
