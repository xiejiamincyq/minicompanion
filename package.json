{
  "name": "devotchi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @devotchi/shared build && pnpm --filter @devotchi/server --filter devotchi build",
    "build:shared": "pnpm --filter @devotchi/shared build",
    "build:server": "pnpm --filter @devotchi/server build",
    "build:client": "pnpm --filter devotchi build",
    "server": "node packages/server/dist/index.js",
    "client": "node packages/client/dist/cli.js",
    "dev": "pnpm --filter devotchi dev"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}