  (text "POWER HARNESS: TWO WIRES ONLY. J7201.1 -> SW7201 THROW_ON (pin1); J7201.2 -> COMMON (pin2).\nSW7201 THROW_OFF (pin3) is deliberately unconnected. Insulate unused switch terminal.\nJ7201.3 remains a board GND pad: DO NOT connect it to the power switch.\nR7114 provides default OFF pull-down when the harness or switch is open."
    (at 25.4 132.08 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left))
    (uuid "4a620595-1668-4af1-b888-17714452b784")))
